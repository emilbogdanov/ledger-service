LEDGER_LOG_LEVEL=INFO
# json or text
LEDGER_LOG_FORMAT=text
LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger
LEDGER_REDIS_URL=redis://localhost:6379/0
# Where the worker publishes account and entry events, and roughly how many it keeps there.
LEDGER_EVENTS_STREAM=ledger:events
LEDGER_EVENTS_STREAM_MAX_LENGTH=1000000
LEDGER_OUTBOX_BATCH_SIZE=100
LEDGER_OUTBOX_POLL_INTERVAL_SECONDS=1.0
LEDGER_OUTBOX_MAX_BACKOFF_SECONDS=30.0
# Port the worker serves Prometheus metrics on; 0 turns it off.
LEDGER_WORKER_METRICS_PORT=9100
